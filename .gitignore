# This .gitignore file should be placed at the root of your Unity project directory
# https://github.com/github/gitignore/blob/main/Unity.gitignore

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# MemoryCaptures can get huge under certain conditions
[Mm]emoryCaptures/

# Asset server cache
[Aa]ssetServerCache/

# Autogenerated VS/MonoDevelop/JetBrains Rider files
[Ee]xplorere/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D File Saver
*.tmp

# Visual Studio Code workspace
.vscode/

# Mac OS specific files
.DS_Store
AppleDouble
LSOverrides

# Thumbnails
._*

# Files that might appear in the root of a project
/[Tt]arget/
.gradle/
export/
*(Axiom)*